{
  "name": "daohang",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply daohang --remote",
    "db:export": "node scripts/db-export.mjs",
    "db:import": "node scripts/db-import.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:account": "node scripts/test-account.mjs",
    "test:admin": "node scripts/test-admin-reset.mjs",
    "mock:resend": "node scripts/mock-resend.mjs",
    "test:disable": "node scripts/test-admin.mjs",
    "mock:imgbed": "node scripts/mock-imgbed.mjs",
    "test:upload": "node scripts/test-upload.mjs",
    "test:meta": "node scripts/test-meta.mjs",
    "test:builtin": "node scripts/test-builtin.mjs",
    "builtin:crawl": "node scripts/crawl-inftab.mjs crawl",
    "builtin:merge": "node scripts/crawl-inftab.mjs merge",
    "icons:rehost": "node scripts/rehost-icons.mjs upload --conc=10 --delay=150",
    "icons:apply": "node scripts/rehost-icons.mjs apply",
    "builtin:import": "node scripts/import-builtin.mjs"
  },
  "dependencies": {
    "cropperjs": "^2.1.1",
    "solarlunar": "^3.1.0",
    "vue": "^3.5.13"
  },
